{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Allows the local main window to edit creations, configure the native credential store, submit generation, and read retained results.",
  "windows": ["main"],
  "permissions": [
    "allow-search-explore",
    "allow-get-explore-detail",
    "allow-read-explore-media",
    "allow-import-explore-image",
    "allow-restore-explore-metadata",
    "allow-get-danbooru-connection",
    "allow-save-danbooru-connection",
    "allow-verify-danbooru-connection",
    "allow-disconnect-danbooru-connection",
    "allow-get-image-analysis-status",
    "allow-get-image-safety",
    "allow-rescan-image-safety",
    "allow-extract-image-tags",
    "allow-edit-text",
    "allow-search-lexicon",
    "allow-get-lexicon-status",
    "allow-get-download-status",
    "allow-refresh-download-catalog",
    "allow-install-download",
    "allow-cancel-download",
    "allow-uninstall-download",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://danbooru.donmai.us/posts/*" },
        { "url": "https://danbooru.donmai.us/profile" },
        { "url": "https://novelai.net/explore/image/*" }
      ]
    },
    "allow-get-application-settings",
    "allow-save-application-preferences",
    "allow-set-data-directory",
    "allow-get-workspace",
    "allow-search-resources",
    "allow-rename-resource-tag",
    "allow-delete-resource-tag",
    "allow-list-resource-folders",
    "allow-save-resource-folder",
    "allow-list-resource-tags",
    "allow-resource-selection-impact",
    "allow-batch-resources",
    "allow-get-resource",
    "allow-get-resource-definitions",
    "allow-save-resource",
    "allow-delete-resource",
    "allow-save-draft",
    "allow-resolve-draft",
    "allow-get-model-defaults-capabilities",
    "allow-get-prompt-syntax",
    "allow-expand-chunk",
    "allow-expand-preset",
    "allow-inspect-tokens",
    "allow-get-account-status",
    "allow-save-account-key",
    "allow-activate-account",
    "allow-delete-account-key",
    "allow-get-account-summary",
    "allow-refresh-account-summary",
    "allow-quote-generation",
    "allow-submit-generation",
    "allow-ensure-vibe-encoding",
    "allow-list-jobs",
    "allow-get-job",
    "allow-cancel-job",
    "allow-retry-job",
    "allow-subscribe-job-feedback",
    "allow-unsubscribe-job-feedback",
    "allow-list-results",
    "allow-get-result",
    "allow-read-media-thumbnail",
    "allow-restore-result",
    "allow-list-media-assets",
    "allow-get-media-asset",
    "allow-import-image-asset",
    "allow-import-resource-cover",
    "allow-discard-resource-cover",
    "allow-read-media-asset",
    "allow-inspect-image-metadata",
    "allow-restore-image-metadata",
    "allow-get-image-operation-options",
    "allow-create-image-operation",
    "allow-create-inpaint-operation",
    "allow-create-precise-reference",
    "allow-create-vibe-encoding-input",
    "allow-get-vibe-encoding-options",
    "allow-create-vibe-reference",
    "allow-inspect-vibe-document",
    "allow-inspect-vibe-asset",
    "allow-import-vibe-asset",
    "allow-import-vibe-document",
    "allow-create-image-vibe-document",
    "allow-create-encoded-vibe-document",
    "allow-bundle-vibe-documents",
    "allow-import-png-vibe-document",
    "allow-export-vibe-document",
    "allow-embed-vibe-document",
    "allow-import-document-image",
    "allow-import-document-encoding",
    "allow-import-embedded-vibes",
    "allow-write-png-text",
    "allow-inspect-png-text",
    "allow-get-director-options",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-is-maximized",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-destroy"
  ]
}
