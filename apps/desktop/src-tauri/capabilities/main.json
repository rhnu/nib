{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Allows the local main window to edit resources and automatically retain the current creation.",
  "windows": ["main"],
  "permissions": [
    "allow-get-workspace",
    "allow-search-resources",
    "allow-get-resource",
    "allow-save-resource",
    "allow-delete-resource",
    "allow-save-draft",
    "allow-resolve-draft",
    "allow-expand-chunk",
    "allow-expand-preset",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy"
  ]
}
